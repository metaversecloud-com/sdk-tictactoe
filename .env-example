# Server

NODE_ENV=development
PORT=3000

# Topia SDK

INTERACTIVE_KEY=your_interactive_key
INTERACTIVE_SECRET=your_interactive_secret
INSTANCE_DOMAIN=api.topia.io
INSTANCE_PROTOCOL=https

# Deployment URL used to wire up webhooks (must end with a slash — the server appends `api/select-player/x` etc)

APP_URL=https://your-app.ngrok-free.app/

# S3 bucket hosting the board sprites (must end with a slash)

BUCKET=https://sdk-tictactoe.s3.amazonaws.com/

# Optional (defaults are fine)

TEXT_ASSET_ID=textAsset
WEB_IMAGE_ASSET_ID=webImageAsset
COMMIT_HASH=

# Optional Google Sheets analytics

GOOGLESHEETS_CLIENT_EMAIL=
GOOGLESHEETS_PRIVATE_KEY=
GOOGLESHEETS_SHEET_ID=
GOOGLESHEETS_SHEET_RANGE=Sheet1
